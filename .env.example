# Copy this file to .env and fill in values
# .env is git-ignored — never commit credentials

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=auditiq
POSTGRES_PASSWORD=auditiq_dev
POSTGRES_DB=auditiq_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Auto-constructed from above (used by backend)
DATABASE_URL=postgresql+psycopg2://auditiq:auditiq_dev@db:5432/auditiq_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Application ───────────────────────────────────────────────────
APP_ENV=development
API_PREFIX=/api
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3001","http://frontend:3000"]
DEFAULT_CURRENCY=INR

# ── Frontend → Backend ────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── Detection Defaults ───────────────────────────────────────
DEFAULT_BENFORD_SENSITIVITY=0.5
DEFAULT_DUPLICATE_SIMILARITY_THRESHOLD=85.0
DEFAULT_ISOLATION_FOREST_CONTAMINATION=0.05
DEFAULT_LOF_CONTAMINATION=0.05
DEFAULT_THREE_WAY_MATCH_TOLERANCE_PCT=0.02
MAX_PARALLEL_WORKERS=4

# ── Score Floors ─────────────────────────────────────────────
MIN_FLAG_THRESHOLD=0.30
MIN_FLAG_THRESHOLD_FS=0.20
ML_COMBINED_SCORE_FLOOR=0.35
MIN_ML_SAMPLE_SIZE=15
MIN_BENFORD_SAMPLE_SIZE=30

# ── Upload Limits ────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Duplicate Detection ──────────────────────────────────────
DUPLICATE_AMOUNT_BUCKET_WIDTH=50.0
DUPLICATE_DATE_PROXIMITY_DAYS=10
DUPLICATE_VENDOR_WEIGHT=0.35
DUPLICATE_INVOICE_WEIGHT=0.25
DUPLICATE_AMOUNT_WEIGHT=0.30
DUPLICATE_DATE_WEIGHT=0.10

# ── Altman Z-Score ───────────────────────────────────────────
ALTMAN_COEFF_A=1.2
ALTMAN_COEFF_B=1.4
ALTMAN_COEFF_C=3.3
ALTMAN_COEFF_D=0.6
ALTMAN_COEFF_E=1.0
ALTMAN_SAFE_THRESHOLD=2.99
ALTMAN_GREY_THRESHOLD=1.81
ALTMAN_DISTRESS_SCORE=0.85
ALTMAN_GREY_SCORE=0.50

# ── Beneish M-Score ──────────────────────────────────────────
BENEISH_THRESHOLD=-2.22
BENEISH_INTERCEPT=-4.84
BENEISH_COEFF_DSRI=0.920
BENEISH_COEFF_GMI=0.528
BENEISH_COEFF_AQI=0.404
BENEISH_COEFF_SGI=0.892
BENEISH_COEFF_DEPI=0.115
BENEISH_COEFF_SGAI=-0.172
BENEISH_COEFF_LVGI=-0.327
BENEISH_COEFF_TATA=4.679

# ── Three-Way Match Rule Weights ─────────────────────────────
RULE_WEIGHT_MISSING_PO=0.9
RULE_WEIGHT_MISSING_GR=0.7
RULE_WEIGHT_PRICE_VARIANCE=0.6
RULE_WEIGHT_QUANTITY_VARIANCE=0.6
RULE_WEIGHT_PO_OVERBILLED=0.85
